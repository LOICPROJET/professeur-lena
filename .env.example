# ── Clé API OpenAI ────────────────────────────────────────────────────────────
# Obtiens ta clé sur : https://platform.openai.com/api-keys
# ⚠️  Ne commit JAMAIS ce fichier avec ta vraie clé.
# Le fichier .env.local est déjà dans .gitignore par Next.js.
OPENAI_API_KEY=

# ── Code PIN de l'espace parent ───────────────────────────────────────────────
# Code à 4 chiffres pour accéder au tableau de bord parent (/parent).
# Valeur par défaut si non définie : 1234
# La vérification se fait côté serveur — jamais exposée dans le navigateur.
PARENT_CODE=1234
